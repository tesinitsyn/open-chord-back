<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Keep CI focused on test outcomes; full diagnostics remain available
         through Surefire reports when a test fails. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.openchord.server" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
